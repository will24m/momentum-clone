{
  "manifest_version": 3,
  "name": "Momentum Todo Workspace",
  "description": "Replace the Chrome new tab page with a premium local-first todo workspace.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://*.supabase.in/*",
    "https://*.williamwu.ca/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}

